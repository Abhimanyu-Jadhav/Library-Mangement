pipeline{

    agent any

    stages{

        stage("Check out code"){
                 
                 steps{

                    git branch : 'main' ,
                    url: 'https://github.com/Abhimanyu-Jadhav/Library-Mangement.git'

                 }
        }

        stage("Build"){

            steps{

                sh 'mvn clean package'
            }
        }

        
    }
}