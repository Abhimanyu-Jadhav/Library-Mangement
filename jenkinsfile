pipeline {
    agent any

   

    stages {
        stage('Check out code') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: 'https://github.com/Abhimanyu-Jadhav/Library-Mangement.git']]
                ])
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Unit test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Sonar Analysis') {
            steps {
                withCredentials([string(credentialsId: 'jenkins-sonar-token', variable: 'SONAR_TOKEN')]) {
    sh """
    mvn sonar:sonar \
    -Dsonar.projectKey=library-management \
    -Dsonar.host.url=http://52.66.239.229:9000 \
    -Dsonar.token=$SONAR_TOKEN
    """
}
            }
        }
    }
}