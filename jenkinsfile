pipeline {
    agent any

    environment {
        SONAR_AUTH_TOKEN = 'squ_909a71371a934f3cf66736d68fdca75582a13f8f'
    }

    stages {
        stage('Check out code') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: 'https://github.com/Abhimanyu-Jadhav/Library-Mangement.git']]
                ])
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Unit test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Sonar Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                    mvn sonar:sonar \
                    -Dsonar.projectKey=library-management \
                    -Dsonar.host.url=http://52.66.239.229:9000 \
                    -Dsonar.token=$SONAR_AUTH_TOKEN
                    '''
                }
            }
        }
    }
}